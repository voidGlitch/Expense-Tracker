{
  "name": "expense-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Personal Monthly Expense & Budget Manager (SRS v0.2)",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "test": "npm run test --workspace shared && npm run test --workspace server && npm run test --workspace client",
    "test:engine": "npm run test --workspace shared",
    "test:server": "npm run test --workspace server",
    "test:client": "npm run test --workspace client",
    "test:watch": "npm run test:watch --workspace shared"
  },
  "devDependencies": {
    "concurrently": "10.0.5"
  }
}
