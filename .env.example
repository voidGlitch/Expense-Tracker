# ---------------------------------------------------------------------------
# Expense Manager — configuration
#
# Copy this file to `.env` (same folder) and edit. Everything here is optional:
# with no .env at all the app runs on a local JSON file, which is the easiest
# way to start.
#
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Storage ---------------------------------------------------------------
# file   (default) one JSON file on disk — zero setup, great for a single user
# mongo  MongoDB / MongoDB Atlas — set MONGODB_URI below
# memory nothing is persisted (used by the tests)
STORAGE_DRIVER=file

# Where the "file" driver keeps data. Relative paths are from this folder.
# DATA_FILE=server/.data/db.json

# --- MongoDB (only needed when STORAGE_DRIVER=mongo) -----------------------
# Free 512 MB cluster, no card required:
#   1. Sign up at https://www.mongodb.com/cloud/atlas/register
#   2. Create a free "M0" cluster (any provider/region near you).
#   3. Database Access -> Add New Database User (username + password).
#   4. Network Access -> Add IP Address -> "Add current IP address"
#      (or 0.0.0.0/0 to allow anywhere — less safe, fine for a quick test).
#   5. Cluster -> Connect -> Drivers -> copy the connection string and paste it
#      below, replacing <db_password> with the password from step 3.
#
# Setting MONGODB_URI is enough — STORAGE_DRIVER switches to mongo on its own.
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=expense_manager

# --- Sessions --------------------------------------------------------------
# Signs the login cookie. Required in production, and must be 32+ characters.
# In development one is generated at boot (you get logged out on restart).
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET=paste-a-long-random-string-here
# JWT_EXPIRES_IN=30d

# --- Server ----------------------------------------------------------------
# PORT=4000
# HOST=127.0.0.1
# NODE_ENV=development

# Cost of bcrypt hashing (10-15). Higher is slower to crack and slower to log in.
# BCRYPT_ROUNDS=12

# Set to false to stop new sign-ups. The first account is always allowed.
# ALLOW_REGISTRATION=true

# Only needed if the client is served from a different origin than the API.
# CORS_ORIGIN=http://localhost:5173

# Cookie tuning. COOKIE_SECURE defaults to true in production (needs HTTPS).
# COOKIE_NAME=em_session
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax
